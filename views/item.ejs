<%- include('./partials/header.ejs') %>

<div class="container">
    <img height="400px" src="/images/<%= item.image %>" alt="<%= item.title %>">

    <div class="details">
        <h1><%= item.title %></h1>
        <p>Condition: <%= item.condition %></p>
        <p>Price: $<%= item.price %></p>
        <p>Seller: <%= item.seller %></p>
        <p><%= item.details %></p>

        <% if (item.active) { %>
        <form action="/items/<%= item.id %>/offers" method="POST">
            <label for="amount">Make an offer: </label>
            <input type="number" id="amount" name="amount" min="0.01" required> <!-- ✅ match controller -->
            <button type="submit">Submit Offer</button>
        </form>

        <% if (item.totalOffers > 0) { %>
            <p>Current Highest Offer: $<%= item.highestOffer %></p>
        <% } %>
        <% } else { %>
            <p>This item is no longer available.</p>
        <% } %>

        <% if (currentUser && currentUser._id.toString() === item.userId.toString()) { %>
        <form action="/items/<%= item.id %>/edit" method="GET">
            <button type="submit">Edit</button>
        </form>

        <form action="/items/<%= item.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this item?');">
            <button type="submit">Delete</button>
        </form>
        <% } %>

        <a href="/items" class="btn">Back To Browse</a>
    </div>
</div>

<%- include('./partials/footer.ejs') %>
